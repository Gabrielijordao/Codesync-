# Copie para .env e substitua todos os placeholders.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hospedja
# Para AWS RDS, instale certificado da CA, configure caminho absoluto:
DB_SSL_CA_PATH=
DB_USER=hospedja_app
DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Opcional: sem esta variavel logs sao stdout, ideal para Docker.
LOG_FILE=
